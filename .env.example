# Copie ce fichier en `.env` puis remplis les valeurs : cp .env.example .env
# Ne commite JAMAIS le fichier .env (il est dans .gitignore).

# --- Image Airflow ---
# Vide : image officielle. Pour utiliser l'image custom (scraper + DAGs) :
#   docker build -t anidata-airflow .   puis   AIRFLOW_IMAGE=anidata-airflow
AIRFLOW_IMAGE=

# --- Elasticsearch ---
ELASTIC_VERSION=8.13.0
ES_JAVA_OPTS=-Xms512m -Xmx512m

# --- PostgreSQL (base de métadonnées d'Airflow) ---
POSTGRES_USER=airflow
POSTGRES_PASSWORD=change-me
POSTGRES_DB=airflow

# --- Airflow ---
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__CORE__LOAD_EXAMPLES=false
AIRFLOW__CORE__DAGS_ARE_PAUSED_AT_CREATION=true
AIRFLOW__WEBSERVER__EXPOSE_CONFIG=false
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres/${POSTGRES_DB}
# Génère une clé Fernet :
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW__CORE__FERNET_KEY=
# Génère une clé secrète :
#   python -c "import secrets; print(secrets.token_hex(32))"
AIRFLOW__WEBSERVER__SECRET_KEY=
AIRFLOW_ADMIN_PASSWORD=change-me

# --- Grafana ---
GRAFANA_ADMIN_PASSWORD=change-me
